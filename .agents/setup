#!/usr/bin/env bash
set -euo pipefail

repo_root="$(cd "$(dirname "${BASH_SOURCE[0]}")/.." && pwd)"
cd "$repo_root"

run_step() {
  local label="$1"
  shift
  local started_at=$SECONDS
  printf '==> %s\n' "$label"
  "$@"
  printf '<== %s (%ss)\n' "$label" "$((SECONDS - started_at))"
}

run_step "Installing npm dependencies" npm ci

if [[ ! -f .env.local ]]; then
  run_step "Creating .env.local" node --input-type=module -e '
    import { randomBytes } from "node:crypto";
    import { readFileSync, writeFileSync } from "node:fs";

    const template = readFileSync("env.example", "utf8");
    const secret = randomBytes(32).toString("hex");
    const config = template.replace(/^BETTER_AUTH_SECRET=$/m, "BETTER_AUTH_SECRET=" + secret);
    if (config === template) {
      throw new Error("In env.example fehlt die erwartete Zeile BETTER_AUTH_SECRET= ohne Wert oder Kommentar.");
    }
    writeFileSync(".env.local", config, { flag: "wx", mode: 0o600 });
  '
else
  printf '==> Keeping existing .env.local\n'
fi

run_step "Generating Next.js route types" npx next typegen
run_step "Installing Playwright Chromium" npx playwright install chromium

printf 'Orb setup complete.\n'
