# Lokale Entwicklungsumgebung
DATABASE_URL=./data/dhbw-mgmt.sqlite
BETTER_AUTH_URL=http://localhost:3000
# Vor dem ersten Start pro Umgebung mit `openssl rand -hex 32` erzeugen und in .env.local eintragen.
BETTER_AUTH_SECRET=

# Optional: genau ein Platzhalter {course}; ohne Angabe wird der aktuelle DHBW-OWA-Endpunkt verwendet.
DHBW_CALENDAR_URL_TEMPLATE=https://webmail.dhbw-loerrach.de/owa/calendar/kal-{course}@dhbw-loerrach.de/Kalender/calendar.ics
