{
  "name": "dhbw-mgmt",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:e2e": "playwright test",
    "migrate:db": "node --env-file-if-exists=.env.local scripts/migrate-db.mjs",
    "backup:db": "node --env-file-if-exists=.env.local scripts/backup-db.mjs",
    "restore:db": "node --env-file-if-exists=.env.local scripts/restore-db.mjs",
    "bootstrap:admin": "node --env-file-if-exists=.env.local scripts/bootstrap-admin.mjs",
    "reset:admin-password": "node --env-file-if-exists=.env.local scripts/reset-admin-password.mjs"
  },
  "dependencies": {
    "better-auth": "^1.6.26",
    "better-sqlite3": "^12.11.1",
    "drizzle-orm": "^0.45.2",
    "next": "16.4.6",
    "react": "19.3.1",
    "react-dom": "19.3.1"
  },
  "devDependencies": {
    "@playwright/test": "^1.62.0",
    "@tailwindcss/postcss": "^4",
    "@types/better-sqlite3": "^9.6.0",
    "@types/node": "^26.6.6",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "eslint": "^9",
    "eslint-config-next": "16.4.6",
    "tailwindcss": "^4",
    "typescript": "^5",
    "vitest": "^4.1.10"
  }
}
